{
  "_comment": "HILS (air-enthalpy) 공통 설정. Python/MATLAB 공용 single source of truth. 단위: degC, %RH, kPa, m3/h, W, s",
  "timing": {
    "Ts_building": 60,
    "Ts_supervisor": 60,
    "Ts_realization": 1,
    "Ts_plc": 1,
    "Ts_plant_internal": 0.1,
    "Ts_zone_sub": 10
  },
  "modbus": {"host": "127.0.0.1", "port": 5020, "unit_id": 1, "base_address": 40001, "timeout_s": 1.0},
  "registers": {
    "T_supply":      {"addr": 40001, "dir": "PLC2SIM", "scale": 100, "signed": true,  "unit": "degC"},
    "RH_supply":     {"addr": 40002, "dir": "PLC2SIM", "scale": 100, "signed": false, "unit": "%"},
    "T_return":      {"addr": 40003, "dir": "PLC2SIM", "scale": 100, "signed": true,  "unit": "degC"},
    "RH_return":     {"addr": 40004, "dir": "PLC2SIM", "scale": 100, "signed": false, "unit": "%"},
    "V_air":         {"addr": 40005, "dir": "PLC2SIM", "scale": 1,   "signed": false, "unit": "m3/h"},
    "P_atm":         {"addr": 40006, "dir": "PLC2SIM", "scale": 100, "signed": false, "unit": "kPa"},
    "T_chamber":     {"addr": 40007, "dir": "PLC2SIM", "scale": 100, "signed": true,  "unit": "degC"},
    "RH_chamber":    {"addr": 40008, "dir": "PLC2SIM", "scale": 100, "signed": false, "unit": "%"},
    "T_outdoor":     {"addr": 40009, "dir": "PLC2SIM", "scale": 100, "signed": true,  "unit": "degC"},
    "RH_outdoor":    {"addr": 40010, "dir": "PLC2SIM", "scale": 100, "signed": false, "unit": "%"},
    "P_HP":          {"addr": 40011, "dir": "PLC2SIM", "scale": 1,   "signed": false, "unit": "W"},
    "HP_status":     {"addr": 40012, "dir": "PLC2SIM", "scale": 1,   "signed": false, "unit": "code"},
    "AckSequence":   {"addr": 40013, "dir": "PLC2SIM", "scale": 1,   "signed": false, "unit": "int"},
    "PLC_status":    {"addr": 40014, "dir": "PLC2SIM", "scale": 1,   "signed": false, "unit": "bitfield"},
    "PLC_heartbeat": {"addr": 40015, "dir": "PLC2SIM", "scale": 1,   "signed": false, "unit": "int"},
    "T_room_SP":     {"addr": 40100, "dir": "SIM2PLC", "scale": 100, "signed": true,  "unit": "degC"},
    "RH_room_SP":    {"addr": 40101, "dir": "SIM2PLC", "scale": 100, "signed": false, "unit": "%"},
    "T_outdoor_SP":  {"addr": 40102, "dir": "SIM2PLC", "scale": 100, "signed": true,  "unit": "degC"},
    "RH_outdoor_SP": {"addr": 40103, "dir": "SIM2PLC", "scale": 100, "signed": false, "unit": "%"},
    "Enable":        {"addr": 40104, "dir": "SIM2PLC", "scale": 1,   "signed": false, "unit": "0/1"},
    "Sequence":      {"addr": 40105, "dir": "SIM2PLC", "scale": 1,   "signed": false, "unit": "int"},
    "SIM_heartbeat": {"addr": 40106, "dir": "SIM2PLC", "scale": 1,   "signed": false, "unit": "int"}
  },
  "plc_status_bits": {"READY": 0, "FAULT": 1, "ESTOP": 2, "TRACKING": 3, "WATCHDOG": 4},
  "hp_status_codes": {"OFF": 0, "HEATING": 1, "COOLING": 2, "DEFROST": 3, "FAULT": 9},
  "setpoint": {
    "_comment": "가상 존 상태 -> 실내측 챔버 설정값. 1 s 층 변화율 제한과 범위 제한",
    "T_rate_K_per_s": 0.05,
    "RH_rate_pct_per_s": 0.2,
    "T_min": 10.0, "T_max": 35.0,
    "RH_min": 15.0, "RH_max": 85.0
  },
  "state_machine": {
    "track_tol_T_K": 0.3,
    "track_tol_RH_pct": 3.0,
    "stabilize_hold_s": 120,
    "stabilize_timeout_s": 1800,
    "step_threshold_T_K": 1.0,
    "step_threshold_RH_pct": 10.0,
    "wait_plc_timeout_s": 60,
    "fault_recover_hold_s": 60,
    "max_auto_restarts": 3
  },
  "safety": {
    "T_chamber_min": 5.0, "T_chamber_max": 40.0,
    "RH_chamber_min": 5.0, "RH_chamber_max": 95.0,
    "heartbeat_timeout_s": 10,
    "ack_timeout_s": 180,
    "P_HP_max": 5000.0,
    "V_air_max": 3000.0,
    "V_air_min_running": 100.0,
    "track_fault_T_K": 3.0,
    "track_fault_hold_s": 300
  },
  "zone": {
    "_comment": "가상 존: 존 공기(T,W) + 외피/구조체 질량(Tm). 입력 = air-enthalpy 실측 열량, 출력 = 다음 시각 존 공기 상태",
    "V_zone_m3": 250.0,
    "C_air_mult": 5.0,
    "moist_mult": 5.0,
    "R_int": 0.0020,
    "R_ext": 0.0045,
    "R_win": 0.0180,
    "C_mass": 3.0e7,
    "A_sol": 3.0,
    "f_sol_air": 0.5,
    "ACH_inf": 0.3,
    "Q_int_occupied": 400.0,
    "Q_int_unoccupied": 100.0,
    "g_int_occupied": 0.00012,
    "g_int_unoccupied": 0.00003,
    "T0": 20.0, "RH0": 40.0, "Tm0": 18.0
  },
  "weather": {
    "winter": {"T_mean": 0.0,  "T_amp": 5.0, "RH": 70.0, "I_peak": 450.0},
    "summer": {"T_mean": 30.0, "T_amp": 4.0, "RH": 55.0, "I_peak": 700.0}
  },
  "emulator": {
    "_comment": "실물이 없을 때 PLC/챔버/히트펌프 실내기를 대신하는 에뮬레이터 파라미터",
    "P_atm": 101.325,
    "C_chamber": 4.0e5,
    "M_chamber_air": 150.0,
    "UA_chamber_lab": 15.0,
    "T_lab": 20.0,
    "T0": 20.0, "RH0": 40.0,
    "pid_T_Kp": 3000.0, "pid_T_Ti": 120.0, "Q_cond_max": 10000.0,
    "pid_W_Kp": 2.0, "pid_W_Ti": 180.0, "m_hum_max": 0.003,
    "act_tau_s": 15.0,
    "outdoor_tau_s": 300.0,
    "meas_noise_T": 0.03, "meas_noise_RH": 0.3, "meas_noise_V_pct": 0.5,
    "ack_delay_s": 3,
    "plc_watchdog_s": 10,
    "ideal_chamber": false,
    "hp_mode": "heat",
    "hp_setpoint_heat": 22.0,
    "hp_setpoint_cool": 25.0,
    "hp_Qmax": 7000.0,
    "hp_Qmin": 1200.0,
    "hp_tau_s": 60.0,
    "hp_Kp": 2500.0,
    "hp_Ti_s": 600.0,
    "hp_carnot_eff": 0.45,
    "hp_min_off_s": 180,
    "hp_hyst": 0.5,
    "hp_airflow_m3h": 900.0,
    "hp_bypass_factor": 0.15,
    "hp_fan_W": 60.0
  }
}
