{
  "_comment": "HILS 공통 설정 (Python / MATLAB 공용 single source of truth). 단위: W, degC, %, s",
  "timing": {
    "Ts_building": 60,
    "Ts_supervisor": 60,
    "Ts_realization": 1,
    "Ts_plc": 1,
    "Ts_plant_internal": 0.1,
    "Ts_log": 1
  },
  "modbus": {
    "host": "127.0.0.1",
    "port": 5020,
    "unit_id": 1,
    "base_address": 40001,
    "timeout_s": 1.0
  },
  "registers": {
    "T_indoor": {"addr": 40001, "dir": "PLC2SIM", "scale": 100, "signed": true, "unit": "degC"},
    "RH_indoor": {"addr": 40002, "dir": "PLC2SIM", "scale": 100, "signed": false, "unit": "%"},
    "T_outdoor": {"addr": 40003, "dir": "PLC2SIM", "scale": 100, "signed": true, "unit": "degC"},
    "P_HP": {"addr": 40004, "dir": "PLC2SIM", "scale": 1, "signed": false, "unit": "W"},
    "Q_HP": {"addr": 40005, "dir": "PLC2SIM", "scale": 1, "signed": true, "unit": "W"},
    "HP_status": {"addr": 40006, "dir": "PLC2SIM", "scale": 1, "signed": false, "unit": "code"},
    "Q_load_meas": {"addr": 40007, "dir": "PLC2SIM", "scale": 1, "signed": true, "unit": "W"},
    "AckSequence": {"addr": 40008, "dir": "PLC2SIM", "scale": 1, "signed": false, "unit": "int"},
    "PLC_status": {"addr": 40009, "dir": "PLC2SIM", "scale": 1, "signed": false, "unit": "bitfield"},
    "PLC_heartbeat": {"addr": 40010, "dir": "PLC2SIM", "scale": 1, "signed": false, "unit": "int"},
    "Q_load_cmd": {"addr": 40100, "dir": "SIM2PLC", "scale": 1, "signed": true, "unit": "W"},
    "T_chamber_SP": {"addr": 40101, "dir": "SIM2PLC", "scale": 100, "signed": true, "unit": "degC"},
    "Enable": {"addr": 40102, "dir": "SIM2PLC", "scale": 1, "signed": false, "unit": "0/1"},
    "Sequence": {"addr": 40103, "dir": "SIM2PLC", "scale": 1, "signed": false, "unit": "int"},
    "SIM_heartbeat": {"addr": 40104, "dir": "SIM2PLC", "scale": 1, "signed": false, "unit": "int"},
    "T_outdoor_SP": {"addr": 40105, "dir": "SIM2PLC", "scale": 100, "signed": true, "unit": "degC"}
  },
  "plc_status_bits": {
    "READY": 0,
    "FAULT": 1,
    "ESTOP": 2,
    "LOAD_ACTIVE": 3,
    "WATCHDOG": 4
  },
  "hp_status_codes": {
    "OFF": 0,
    "HEATING": 1,
    "COOLING": 2,
    "DEFROST": 3,
    "FAULT": 9
  },
  "realization_controller": {
    "Kp": 0.4,
    "Ki": 0.02,
    "feedforward_gain": 1.0,
    "rate_limit_W_per_s": 50.0,
    "Q_cmd_min": -8000.0,
    "Q_cmd_max": 8000.0,
    "delay_compensation": true,
    "plant_tau_s": 20.0,
    "plant_gain": 1.0
  },
  "state_machine": {
    "stabilize_tol_W": 300.0,
    "stabilize_hold_s": 120,
    "stabilize_timeout_s": 1800,
    "step_threshold_W": 500.0,
    "wait_plc_timeout_s": 60,
    "fault_recover_hold_s": 60
  },
  "safety": {
    "T_indoor_min": 10.0,
    "T_indoor_max": 35.0,
    "RH_max": 90.0,
    "heartbeat_timeout_s": 10,
    "ack_timeout_s": 120,
    "P_HP_max": 4000.0
  },
  "virtual_building": {
    "_comment": "2R2C: 존 공기 노드는 실측 챔버온도(T_indoor)로 경계, 외피/구조체 질량 노드는 가상",
    "R_ext": 0.0045,
    "R_int": 0.002,
    "R_win": 0.018,
    "C_mass": 30000000.0,
    "A_sol": 3.0,
    "Q_int_occupied": 400.0,
    "Q_int_unoccupied": 100.0
  },
  "emulator": {
    "_comment": "실물이 없을 때 PLC/챔버/히트펌프를 대신하는 에뮬레이터 파라미터",
    "C_chamber": 400000.0,
    "UA_chamber_lab": 15.0,
    "T_lab": 20.0,
    "load_tau_s": 20.0,
    "load_gain_error": 0.93,
    "load_bias_W": -150.0,
    "meas_noise_W": 30.0,
    "ack_delay_s": 3,
    "hp_setpoint": 22.0,
    "hp_Qmax": 7000.0,
    "hp_Qmin": 1200.0,
    "hp_tau_s": 60.0,
    "hp_Kp": 2500.0,
    "hp_Ti_s": 600.0,
    "hp_carnot_eff": 0.45,
    "hp_min_off_s": 180,
    "hp_hyst": 0.5,
    "plc_watchdog_s": 10
  }
}
